---
import site from "../data/site.json";
---

<footer class="mt-20 border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-fog sm:flex-row sm:items-end sm:justify-between sm:px-6">
    <div class="flex items-start gap-3">
      <img src={site.logo} alt="" width="48" height="48" class="h-12 w-12 rounded-xl object-contain" />
      <div>
        <p class="font-display text-3xl tracking-[0.14em] text-paper">{site.name}</p>
        <p class="mt-1 max-w-md">{site.tagline}. Catálogo con precios de lista y efectivo.</p>
        {
          !site.whatsapp && (
            <p class="mt-3 text-xs text-fog/80">
              Para activar consultas, agregá tu número en <code class="text-acid">src/data/site.json</code>.
            </p>
          )
        }
      </div>
    </div>
    <p class="text-xs">© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
  </div>
</footer>
