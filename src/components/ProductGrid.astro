---
import type { Product } from "../lib/catalog";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: Product[];
  categories: string[];
}

const { products, categories } = Astro.props;
---

<div class="space-y-8" data-catalog>
  <div class="grid gap-4 sm:grid-cols-2 sm:max-w-xl">
    <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.16em] text-fog sm:col-span-2">
      Buscar
      <input
        type="search"
        data-filter="q"
        placeholder="Nombre o sabor"
        class="filter-input"
        autocomplete="off"
      />
    </label>
    <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.16em] text-fog">
      Categoría
      <select
        data-filter="categoria"
        class="filter-select"
      >
        <option value="todas">Todas</option>
        {categories.map((cat) => <option value={cat}>{cat}</option>)}
      </select>
    </label>
    <label class="grid gap-2 text-xs font-bold uppercase tracking-[0.16em] text-fog">
      Disponibilidad
      <select
        data-filter="stock"
        class="filter-select"
      >
        <option value="todas">Todos</option>
        <option value="si">Con stock</option>
        <option value="no">Sin stock</option>
      </select>
    </label>
  </div>

  <p class="text-sm text-fog" data-count></p>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {products.map((product) => <ProductCard product={product} />)}
  </div>

  <p class="hidden rounded-2xl border border-dashed border-line px-6 py-16 text-center text-fog" data-empty>
    No hay productos para ese filtro.
  </p>
</div>

<style>
  .filter-select {
    width: 100%;
    appearance: none;
    border-radius: 0.9rem;
    border: 1px solid var(--color-line);
    background: var(--color-panel)
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%23d6ff3c' d='M1 1l5 5 5-5'/></svg>")
      no-repeat right 1rem center;
    padding: 0.7rem 2.4rem 0.7rem 0.9rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-paper);
  }
  .filter-select:hover,
  .filter-select:focus {
    border-color: var(--color-acid);
    outline: none;
  }
  .filter-input {
    width: 100%;
    border-radius: 0.9rem;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    padding: 0.7rem 0.9rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-paper);
  }
  .filter-input::placeholder {
    color: var(--color-fog);
    font-weight: 500;
  }
  .filter-input:hover,
  .filter-input:focus {
    border-color: var(--color-acid);
    outline: none;
  }
</style>

<script>
  import { fold } from "../lib/catalog";

  const FILTERS_KEY = "sasu-catalog-filters";

  function setupCatalog(root: Element) {
    const el = root as HTMLElement;
    if (el.dataset.ready === "1") return;
    el.dataset.ready = "1";
    const cards = [...root.querySelectorAll<HTMLElement>("article[data-category]")];
    const empty = root.querySelector<HTMLElement>("[data-empty]");
    const count = root.querySelector<HTMLElement>("[data-count]");
    const grid = cards[0]?.parentElement;
    const queryInput = root.querySelector<HTMLInputElement>('[data-filter="q"]');
    const categoriaSelect = root.querySelector<HTMLSelectElement>('[data-filter="categoria"]');
    const stockSelect = root.querySelector<HTMLSelectElement>('[data-filter="stock"]');

    const restore = () => {
      try {
        const saved = JSON.parse(sessionStorage.getItem(FILTERS_KEY) || "null") as {
          q?: string;
          categoria?: string;
          stock?: string;
        } | null;
        if (!saved) return;
        if (queryInput && typeof saved.q === "string") queryInput.value = saved.q;
        if (
          categoriaSelect &&
          saved.categoria &&
          [...categoriaSelect.options].some((option) => option.value === saved.categoria)
        ) {
          categoriaSelect.value = saved.categoria;
        }
        if (stockSelect && (saved.stock === "todas" || saved.stock === "si" || saved.stock === "no")) {
          stockSelect.value = saved.stock;
        }
      } catch {
        sessionStorage.removeItem(FILTERS_KEY);
      }
    };

    const save = () => {
      sessionStorage.setItem(
        FILTERS_KEY,
        JSON.stringify({
          q: queryInput?.value ?? "",
          categoria: categoriaSelect?.value ?? "todas",
          stock: stockSelect?.value ?? "todas",
        }),
      );
    };

    const apply = () => {
      const words = fold(queryInput?.value ?? "")
        .split(/\s+/)
        .filter(Boolean);
      const categoria = categoriaSelect?.value ?? "todas";
      const stock = stockSelect?.value ?? "todas";
      let visible = 0;
      for (const card of cards) {
        const text = card.dataset.search ?? "";
        const textOk = words.every((word) => text.includes(word));
        const catOk = categoria === "todas" || card.dataset.category === categoria;
        const stockOk = stock === "todas" || card.dataset.stock === stock;
        const show = textOk && catOk && stockOk;
        card.classList.toggle("hidden", !show);
        if (show) visible += 1;
      }
      empty?.classList.toggle("hidden", visible !== 0);
      grid?.classList.toggle("hidden", visible === 0);
      if (count) {
        count.textContent = visible === 1 ? "1 producto" : `${visible} productos`;
      }
      save();
    };

    restore();
    queryInput?.addEventListener("input", apply);
    categoriaSelect?.addEventListener("change", apply);
    stockSelect?.addEventListener("change", apply);
    apply();
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-catalog]").forEach(setupCatalog);
  });
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("[data-catalog]").forEach(setupCatalog);
  });
</script>
